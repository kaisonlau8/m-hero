# reportdb production env (append to ~/m-hero-run/reportdb.env AFTER the Casdoor accounts exist). OIDC-only; local login stays in code but disabled.
export REPORTDB_AUTH_BACKEND=oidc
export REPORTDB_OIDC_ISSUER=https://sso-m-hero.41box.com
export REPORTDB_OIDC_CLIENT_ID=<from ~/m-hero-run/casdoor-client.env>
export REPORTDB_OIDC_CLIENT_SECRET=<from ~/m-hero-run/casdoor-client.env>
export REPORTDB_OIDC_REDIRECT_URI=https://m-hero-report.41box.com/auth/oidc/callback
export REPORTDB_OIDC_USERNAME_CLAIM=preferred_username
export REPORTDB_OIDC_ADMIN_GROUPS=mhero-admin
export REPORTDB_OIDC_SUPERVISOR_GROUPS=mhero-supervisor
export REPORTDB_OIDC_REQUIRE_ROLE=1        # needs patches/reportdb-oidc-require-role.patch
export REPORTDB_SESSION_HOURS=720          # 30 days

appname = casdoor
httpport = 8000
runmode = prod
copyrequestbody = true
driverName = sqlite
dataSourceName = file:/home/ubuntu/casdoor/data/casdoor.db?cache=shared
dbName = casdoor
tableNamePrefix =
showSql = false


[program:casdoor]
command=/home/ubuntu/m-hero-run/casdoor/casdoor
directory=/home/ubuntu/m-hero-run/casdoor
autostart=true
autorestart=true
startsecs=5
startretries=1000
stopasgroup=true
killasgroup=true
redirect_stderr=true
stdout_logfile=/home/ubuntu/m-hero-run/logs/casdoor.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=3

[program:casdoor-backup]
command=/home/ubuntu/m-hero-run/casdoor/backup_loop.sh
directory=/home/ubuntu/m-hero-run/casdoor
autostart=true
autorestart=true
startsecs=5
startretries=1000
stopasgroup=true
killasgroup=true
redirect_stderr=true
stdout_logfile=/home/ubuntu/m-hero-run/logs/casdoor-backup.log
stdout_logfile_maxbytes=5MB
stdout_logfile_backups=2
